type specific_delimiters = {
  decimal_separator : string;
  money_delim : string;
  money_op_suffix : string;
  money_prefix : string;
  money_suffix : string;
}

type types = {
  boolean : string;
  date : string;
  decimal : string;
  duration : string;
  integer : string;
  money : string;
  position : string;
}

type optionals = {
  present : string;
  absent : string;
}

type functions = {
  round : string;
  impossible : string;
  cardinal : string;
}

type builtins = {
  types : types;
  optionals : optionals;
  functions : functions ;
}

type directives = {
  external_ <json name="external">  : string;
  law_include : string;
  module_alias : string;
  module_def : string;
  module_use : string;
}

type language = {
  lang_name : string;
  file_ext_suffix: string;
  tokens : tokens;
  specific_delimiters : specific_delimiters;
  builtins : builtins;
  directives : directives;
}
