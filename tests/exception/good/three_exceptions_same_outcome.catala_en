```catala-test-cli
$ catala dcalc -s A --trace
let scope A (A_in: A_in): A =
  let set y : ⟪integer⟫ = ⟨ ⟨true ⊢ ⟨0⟩⟩ | false ⊢ ∅ ⟩ in
  let set z : ⟪integer⟫ = ⟨ ⟨true ⊢ ⟨0⟩⟩ | false ⊢ ∅ ⟩ in
  let set w : ⟪integer⟫ = ⟨ ⟨true ⊢ ⟨0⟩⟩ | false ⊢ ∅ ⟩ in
  let set x : integer =
    error_empty
      ⟨ ⟨ let b : bool = error_empty y = 0 in
          ⟨ let b1 : bool = error_empty z = 0 in
            ⟨ ⟨error_empty w = 0 ⊢ ⟨0⟩⟩ | b1 ⊢ ⟨0⟩ ⟩
          | b ⊢ ⟨0⟩ ⟩
        | false ⊢ ∅ ⟩
      | true ⊢ ⟨ ⟨true ⊢ ⟨-1⟩⟩ | false ⊢ ∅ ⟩ ⟩
  in
  return { A x = x; }
```
