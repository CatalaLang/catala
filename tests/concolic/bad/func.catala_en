## Article

```catala
declaration positive content boolean
    depends on x content integer
    equals x >= 0

declaration scope A:
    input f content boolean depends on x content integer
    input x content integer
    internal r content boolean
    output o condition

scope A:
    definition r equals f of x
    rule o under condition r consequence fulfilled

declaration scope B:
    input x content integer
    internal r content boolean
    output o content integer

scope B:
    definition r equals (output of A with { -- f : positive -- x : x}).o
    definition o equals 0
    exception definition o under condition r and x>10 consequence equals 1
    exception definition o under condition r and x<=10 consequence equals 2
    exception definition o under condition r and x<-10 consequence equals -3 # unreachable

declaration scope TestB:
    internal o content integer

scope TestB:
    definition o equals (output of B with {-- x: 10}).o
    assertion o = 2
```

```catala-test-cli
$ catala DCalc

type A_in = { f_in: integer → bool; x_in: integer; }

type A = { o: bool; }

type B_in = { x_in: integer; }

type B = { o: integer; }

type TestB_in = {  }

type TestB = {  }

let scope A (A_in: A_in): A =
  let get f : integer → bool = A_in.f_in in
  let get x : integer = A_in.x_in in
  let set r : ⟪bool⟫ = ⟨ ⟨true ⊢ ⟨f x⟩⟩ | false ⊢ ∅ ⟩ in
  let set o : bool =
    error_empty
      ⟨ ⟨ ⟨error_empty r ⊢ ⟨true⟩⟩ | false ⊢ ∅ ⟩
      | true ⊢ ⟨ ⟨true ⊢ ⟨false⟩⟩ | false ⊢ ∅ ⟩ ⟩
  in
  return { A o = o; }

let topval positive : integer → bool =
  λ (x: integer) →
  x ≥ 0

let scope B (B_in: B_in): B =
  let get x : integer = B_in.x_in in
  let set r : ⟪bool⟫ =
    ⟨ ⟨true
       ⊢ ⟨(let result : A = A { A_in f_in = positive; x_in = x; } in
           let result1 : A = { A o = result.o; } in
           result1).
            o⟩⟩
    | false ⊢ ∅ ⟩
  in
  let set o : integer =
    error_empty
      ⟨ ⟨ ⟨(error_empty r) && x > 10 ⊢ ⟨1⟩⟩,
          ⟨(error_empty r) && x ≤ 10 ⊢ ⟨2⟩⟩,
          ⟨(error_empty r) && x < -10 ⊢ ⟨-3⟩⟩
        | false ⊢ ∅ ⟩
      | true ⊢ ⟨ ⟨true ⊢ ⟨0⟩⟩ | false ⊢ ∅ ⟩ ⟩
  in
  return { B o = o; }

let scope TestB (TestB_in: TestB_in): TestB =
  let set o : ⟪integer⟫ =
    ⟨ ⟨true
       ⊢ ⟨(let result : B = B { B_in x_in = 10; } in
           let result1 : B = { B o = result.o; } in
           result1).
            o⟩⟩
    | false ⊢ ∅ ⟩
  in
  let assert assert__1 : unit = assert (error_empty o = 2) in
  return {TestB}

```

Scope A takes a function as input. The concrete interpreter always gives it the
value (λ () -> ∅). This works for context variables that do take unit argument
and catch the EmptyError. However, proper functions don't behave properly in
this context. This is expected behaviour for the concrete interpreter, but the
then it fails with an emtpy error.

For now, the concolic interpreter detects functions that do not encode context
variables, and refuses to procede:

```catala-test-cli
$ catala Concolic --conc-optim=incremental -s A
┌─[ERROR]─
│
│  This input of the scope is a function. This case is not handled by the concolic interpreter for now. You may want to call this scope from an other scope and provide a specific function as argument.
│
├─➤ tests/concolic/bad/func.catala_en:9.11-12:
│   │
│ 9 │     input f content boolean depends on x content integer
│   │           ‾
└─ Article
#return code 123#
```

However, the concrete interpreter can handle `B` which calls scope `A` with a
specific function and input.

```catala-test-cli
$ catala Interpret -s TestB
┌─[RESULT]─ TestB ─
│ Computation successful!
└─
```

And now the concolic interpreter can do that as well, and even gather a
constraint from it and negate it!
Note that there are a few too many warnings for now.

```catala-test-cli
$ catala Concolic --conc-optim=incremental -s B
┌─[RESULT]─ Concolic execution ─
│ Executed 3 tests:
│     Inputs │ Outputs
│ ────── Test #1 ────
│ x_in = 0   │ o = 2
│ ────── Test #2 ────
│ x_in = 11  │ o = 1
│ ────── Test #3 ────
│ x_in = -1  │ o = 0
└─
```
