```catala
declaration enumeration E:
-- E1
-- E2
-- E3
-- E4
-- E5
-- E6
-- E7
-- E8
-- E9

declaration scope A:
    input e content E
    output o content integer

scope A:
    definition o equals 0
    exception definition o under condition
        (match e with pattern
        -- E1: true
        -- E9: true
        -- anything: false)
    consequence equals 1
    exception definition o under condition
        (match e with pattern
        -- E1: true
        -- E2: true
        -- anything: false)
    consequence equals 2
```

```catala-test-cli
$ catala DCalc -s A
let scope A (A_in: A_in): A =
  let get e : E = A_in.e_in in
  let set o : integer =
    error_empty
      ⟨ ⟨ ⟨match e with
           | E1 → true
           | E2 → false
           | E3 → false
           | E4 → false
           | E5 → false
           | E6 → false
           | E7 → false
           | E8 → false
           | E9 → true
           ⊢ ⟨1⟩⟩,
          ⟨match e with
           | E1 → true
           | E2 → true
           | E3 → false
           | E4 → false
           | E5 → false
           | E6 → false
           | E7 → false
           | E8 → false
           | E9 → false
           ⊢ ⟨2⟩⟩
        | false ⊢ ∅ ⟩
      | true ⊢ ⟨ ⟨true ⊢ ⟨0⟩⟩ | false ⊢ ∅ ⟩ ⟩
  in
  return { A o = o; }
```

```catala-test-cli
$ catala DCalc -s A --optimize
let scope A (A_in: A_in): A =
  let get e : E = A_in.e_in in
  let set o : integer =
    error_empty
      ⟨ ⟨ if
            match e with
            | E1 → true
            | E2 → false
            | E3 → false
            | E4 → false
            | E5 → false
            | E6 → false
            | E7 → false
            | E8 → false
            | E9 → true
          then
            ⟨1⟩
          else ∅,
          if
            match e with
            | E1 → true
            | E2 → true
            | E3 → false
            | E4 → false
            | E5 → false
            | E6 → false
            | E7 → false
            | E8 → false
            | E9 → false
          then
            ⟨2⟩
          else ∅
        | false ⊢ ∅ ⟩
      | true ⊢ ⟨0⟩ ⟩
  in
  return { A o = o; }
```

