## Article

```catala
declaration scope A:
  input x content integer
  input y content integer
  input z content integer
  input t content integer
  output o content integer

scope A:
  exception definition o under condition not ((x-y+z * 1 < -t) and (x > y)) or ((z <= t) xor (x >= z))
  consequence equals 0
  definition o equals -1
```

```catala-test-cli
$ catala DCalc -s A
let scope A (A_in: A_in): A =
  let get x : integer = A_in.x_in in
  let get y : integer = A_in.y_in in
  let get z : integer = A_in.z_in in
  let get t : integer = A_in.t_in in
  let set o : integer =
    error_empty
      ⟨ ⟨ ⟨(not (x - y + z * 1 < - t && x > y)) || (z ≤ t xor x ≥ z) ⊢ ⟨0⟩⟩
        | false ⊢ ∅ ⟩
      | true ⊢ ⟨ ⟨true ⊢ ⟨-1⟩⟩ | false ⊢ ∅ ⟩ ⟩
  in
  return { A o = o; }
```

