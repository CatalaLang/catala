## Test

```catala
declaration structure T:
   data c content boolean

declaration structure S:
    data a content integer
    data b content T

declaration scope A:
  input m content integer
  input s content S
  input t content T
  output o condition

scope A:
  rule o under condition ((s.a = m) or s.b.c) and ((t = s.b) or t.c = false) consequence fulfilled
```

```catala-test-cli
$ catala DCalc -s A
let scope A (A_in: A_in): A =
  let get m : integer = A_in.m_in in
  let get s : S = A_in.s_in in
  let get t : T = A_in.t_in in
  let set o : bool =
    error_empty
      ⟨ ⟨ ⟨(s.a = m || s.b.c) && (t = s.b || t.c = false) ⊢ ⟨true⟩⟩
        | false ⊢ ∅ ⟩
      | true ⊢ ⟨ ⟨true ⊢ ⟨false⟩⟩ | false ⊢ ∅ ⟩ ⟩
  in
  return { A o = o; }
```

```catala-test-cli
$ catala Concolic --conc-optim=incremental -s A
┌─[RESULT]─ Concolic execution ─
│ Executed 2 tests:
│                                    Inputs │ Outputs
│ ───────────────────────────────────── Test #1 ────────
│ m_in = 0                                  │ o = true
│ s_in = { S a = 0; b = { T c = true; }; }  │
│ t_in = { T c = true; }                    │
│ ───────────────────────────────────── Test #2 ────────
│ m_in = 0                                  │ o = false
│ s_in = { S a = 2; b = { T c = false; }; } │
│ t_in = { T c = true; }                    │
└─
```

