## Article

```catala
declaration enumeration E:
  -- E1 content integer
  -- E2 content boolean
  -- E3

declaration scope A:
  input x content E
  output o content integer

scope A:
  definition o equals
    match x with pattern
    -- E1 content i : if i < 0 then 0 else 1
    -- E2 content b : if b then 2 else 3
    -- E3 : 4
```

```catala-test-cli
$ catala DCalc -s A
let scope A (A_in: A_in): A =
  let get x : E = A_in.x_in in
  let set o : integer =
    error_empty
      ⟨ ⟨true
         ⊢ ⟨match x with
            | E1 i → if i < 0 then 0 else 1
            | E2 b → if b then 2 else 3
            | E3 → 4⟩⟩
      | false ⊢ ∅ ⟩
  in
  return { A o = o; }
```

```catala-test-cli
$ catala Concolic --conc-optim=incremental -s A
┌─[RESULT]─ Concolic execution ─
│ Executed 5 tests:
│                  Inputs │ Outputs
│ ─────────────────── Test #1 ────
│ x_in = E1 content 0     │ o = 1
│ ─────────────────── Test #2 ────
│ x_in = E1 content -1    │ o = 0
│ ─────────────────── Test #3 ────
│ x_in = E2 content false │ o = 3
│ ─────────────────── Test #4 ────
│ x_in = E2 content true  │ o = 2
│ ─────────────────── Test #5 ────
│ x_in = E3               │ o = 4
└─
```
