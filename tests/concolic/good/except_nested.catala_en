## Article

```catala
declaration scope A:
    input x content integer
    output o content integer

scope A:
    label l0
    definition o equals 0

    label l1_0
    exception l0 definition o under condition x=2 consequence equals 1
    label l1_1
    exception l0 definition o under condition x<1 consequence equals 2

    label l2
    exception l1_1 definition o under condition x=30 consequence equals 3
```

```catala-test-cli
$ catala DCalc -s A
let scope A (A_in: A_in): A =
  let get x : integer = A_in.x_in in
  let set o : integer =
    error_empty
      ⟨ ⟨ ⟨ ⟨x = 30 ⊢ ⟨3⟩⟩ | false ⊢ ∅ ⟩
        | true ⊢ ⟨ ⟨x < 1 ⊢ ⟨2⟩⟩ | false ⊢ ∅ ⟩ ⟩,
        ⟨ ⟨x = 2 ⊢ ⟨1⟩⟩ | false ⊢ ∅ ⟩
      | true ⊢ ⟨ ⟨true ⊢ ⟨0⟩⟩ | false ⊢ ∅ ⟩ ⟩
  in
  return { A o = o; }
```

```catala-test-cli
$ catala Concolic --conc-optim=incremental -s A
┌─[RESULT]─ Concolic execution ─
│ Executed 4 tests:
│     Inputs │ Outputs
│ ────── Test #1 ────
│ x_in = 0   │ o = 2
│ ────── Test #2 ────
│ x_in = 1   │ o = 0
│ ────── Test #3 ────
│ x_in = 2   │ o = 1
│ ────── Test #4 ────
│ x_in = 30  │ o = 3
└─
```

