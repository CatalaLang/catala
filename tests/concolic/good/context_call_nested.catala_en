## Article

```catala
declaration scope A:
    context output x content integer
    output o content integer

scope A:
    definition x equals 30
    definition o equals 1
    exception definition o under condition x<0 consequence equals 2
    exception definition o under condition x=30 consequence equals 3

declaration scope B:
    a scope A
    context output x content integer
    output o content integer

scope B:
    definition x equals 20
    definition a.x equals x
    definition o equals a.o
```

The symbolic value from the context variable is properly propagated into the
context variable of the callee.

```catala-test-cli
$ catala DCalc -s B
let scope B (B_in: B_in): B =
  let get x : ⟪integer⟫ = B_in.x_in in
  let set x : integer =
    error_empty ⟨ x | true ⊢ ⟨error_empty ⟨ ⟨true ⊢ ⟨20⟩⟩ | false ⊢ ∅ ⟩⟩ ⟩
  in
  let set a : A =
    let result : A = A { A_in x_in = ⟨ ⟨true ⊢ ⟨x⟩⟩ | false ⊢ ∅ ⟩; } in
    let result1 : A = { A x = result.x; o = result.o; } in
    result1
  in
  let set o : integer = error_empty ⟨ ⟨true ⊢ ⟨a.o⟩⟩ | false ⊢ ∅ ⟩ in
  return { B x = x; o = o; }
```

```catala-test-cli
$ catala Concolic --conc-optim=incremental -s B
┌─[RESULT]─ Concolic execution ─
│ Executed 4 tests:
│     Inputs │ Outputs
│ ────── Test #1 ─────
│ x_in = 0   │ x = 0
│            │ o = 1
│ ────── Test #2 ─────
│ x_in = 30  │ x = 30
│            │ o = 3
│ ────── Test #3 ─────
│ x_in = -1  │ x = -1
│            │ o = 2
│ ────── Test #4 ─────
│ x_in = ø   │ x = 20
│            │ o = 1
└─
```
