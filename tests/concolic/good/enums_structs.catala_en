## Article

This test aims at making sure structs and enums interoperate properly.

```catala
declaration enumeration EnumA:
  -- A1 content integer
  -- A2 content boolean

declaration structure StructS:
  data a content EnumA

declaration enumeration EnumB:
  -- B1 content EnumA
  -- B2 content StructS

declaration structure StructT:
  data a content EnumA
  data s content StructS
  data b content EnumB

declaration scope A:
  input a content EnumA
  input s content StructS
  input b content EnumB
  input t content StructT
  output o content integer

scope A:
  definition o equals -1
  exception
  definition o
  under condition
    a != A1 content 42
    and s.a = A2 content false
    and b = B2 content s
    and t.a != a
    and t.s.a = a
    and t.b != B1 content a
  consequence equals
    1
```

```catala-test-cli
$ catala DCalc -s A
let scope A (A_in: A_in): A =
  let get a : EnumA = A_in.a_in in
  let get s : StructS = A_in.s_in in
  let get b : EnumB = A_in.b_in in
  let get t : StructT = A_in.t_in in
  let set o : integer =
    error_empty
      ⟨ ⟨ ⟨(a ≠ A1 42)
           && s.a = A2 false
           && b = B2 s
           && (t.a ≠ a)
           && t.s.a = a
           && t.b ≠ B1 a
           ⊢ ⟨1⟩⟩
        | false ⊢ ∅ ⟩
      | true ⊢ ⟨ ⟨true ⊢ ⟨-1⟩⟩ | false ⊢ ∅ ⟩ ⟩
  in
  return { A o = o; }
```

```catala-test-cli
$ catala Concolic --conc-optim=incremental -s A
┌─[RESULT]─ Concolic execution ─
│ Executed 2 tests:
│                               Inputs │ Outputs
│ ──────────────────────────────── Test #1 ─────
│ a_in = A1 content 0                  │ o = -1
│ s_in = StructS {                     │
│          -- a: A1 content 0          │
│        }                             │
│ b_in = B1 content A1 content 0       │
│ t_in =                               │
│   StructT {                          │
│     -- a: A1 content 0               │
│     -- s: StructS {                  │
│       -- a: A1 content 0             │
│     }                                │
│     -- b: B1 content A1 content 0    │
│   }                                  │
│ ──────────────────────────────── Test #2 ─────
│ a_in = A2 content false              │ o = 1
│ s_in = StructS {                     │
│          -- a: A2 content false      │
│        }                             │
│ b_in = B2 content StructS {          │
│            -- a: A2 content false    │
│          }                           │
│ t_in =                               │
│   StructT {                          │
│     -- a: A2 content true            │
│     -- s: StructS {                  │
│       -- a: A2 content false         │
│     }                                │
│     -- b: B1 content A2 content true │
│   }                                  │
└─
```
